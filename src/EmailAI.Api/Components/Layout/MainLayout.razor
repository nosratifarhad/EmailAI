@inherits LayoutComponentBase

<div class="app-root">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">EmailAI</span>
        </div>
        <a class="header-link" href="/settings" title="Settings — AI API key and Exchange account">⚙ Settings</a>
        <HealthStatusBadge />
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
