{
  // SAMPLE VALUES ONLY - no real endpoint or credential may ever be committed here.
  // "mail.example.com" is the reserved documentation host (RFC 2606): EmailAI refuses to
  // treat it as a real endpoint, reports "Exchange is not configured" and never touches the
  // network. Supply the real deployment values through environment variables
  // (EXCHANGE_EWS_URL, EXCHANGE_AUTHENTICATION, EXCHANGE_DOMAIN, EXCHANGE_USERNAME,
  // EXCHANGE_PASSWORD - see .env.example) or let each user configure Exchange in Settings
  // (%APPDATA%\EmailAI\settings.json + Windows Credential Manager).
  "Exchange": {
    "EwsUrl": "https://mail.example.com/EWS/Exchange.asmx",
    "Authentication": "Windows",
    "Mailbox": "",
    "ExchangeVersion": "Exchange2013_SP1",
    "TimeoutSeconds": 90
  },
  "Ai": {
    "BaseUrl": "",
    "Model": "",
    "TimeoutSeconds": 120,
    "CredentialSource": "auto"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EmailAI.Infrastructure.Exchange": "Information"
    }
  },
  "AllowedHosts": "*"
}
