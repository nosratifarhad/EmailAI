# =====================================================================
# EmailAI - example environment configuration (copy to .env, fill in)
# NEVER commit real credentials. All values here are placeholders.
# =====================================================================

# ---------------------------------------------------------------------
# Exchange (EWS) configuration
# ---------------------------------------------------------------------
# Values in appsettings.json are SAMPLE PLACEHOLDERS (mail.example.com). At runtime
# these EXCHANGE_* environment variables ALWAYS override appsettings.json - the
# application never treats the sample host as a real endpoint.
# EWS endpoint of the on-premises Exchange server.
EXCHANGE_EWS_URL=https://mail.example.com/EWS/Exchange.asmx

# Authentication mode - EXPLICIT, exactly one mode, no automatic fallback:
#   Windows          - authenticate with the current Windows/process identity ONLY.
#                      No EXCHANGE_USERNAME/EXCHANGE_PASSWORD are required (and they
#                      are never used). A rejected Windows account is a clear
#                      authentication error - the app never silently retries with a
#                      password or NTLM fallback.
#   UsernamePassword - authenticate with the explicit account below ONLY.
#                      EXCHANGE_USERNAME and EXCHANGE_PASSWORD are both REQUIRED.
#                      The current Windows identity is never used and is never tried
#                      as a fallback.
EXCHANGE_AUTHENTICATION=Windows
EXCHANGE_DOMAIN=
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=

# Optional: explicit mailbox to access on behalf of (EWS impersonation).
# Not used by the vertical slice. Leave empty to use the credential's own mailbox.
EXCHANGE_MAILBOX=

# Exchange server version hint (allowed: Exchange2007_SP1 ... Exchange2013_SP1).
# A lower client version is always accepted by newer servers.
EXCHANGE_VERSION=Exchange2013_SP1

# EWS HTTP timeout in seconds.
EXCHANGE_TIMEOUT_SECONDS=90

# Desktop users can configure Exchange entirely from the Settings page instead of using
# these variables: the non-secret endpoint/mode/account are stored per user in
# %APPDATA%\EmailAI\settings.json and the password in Windows Credential Manager
# (target "EmailAI/Exchange"). A saved per-user configuration is authoritative AS A WHOLE
# for that Windows account - the EXCHANGE_* variables above are then ignored for it.
# They stay the fallback for every account that has not configured Exchange, and their
# credentials are never mixed with the per-user ones.

# ---------------------------------------------------------------------
# AI - OpenAI-compatible provider
# ---------------------------------------------------------------------
# EmailAI talks directly to any OpenAI-compatible Chat Completions API - there is no
# gateway in the middle. AI_BASE_URL is the API root your provider gave you, e.g.
#   https://api.openai.com/v1
#   https://your-company-ai.example.com/v1
# A trailing slash is fine: the server normalises it and always calls exactly
# {AI_BASE_URL}/chat/completions. Leave AI_API_KEY empty only when your provider
# needs no authentication.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=

# Where the AI API key comes from:
#   auto        (default) Windows Credential Manager is authoritative for desktop
#               users; AI_API_KEY above is only a fallback when the store is empty.
#   windows     the per-user Windows Credential Manager is the only source (desktop).
#   environment AI_API_KEY is the only source (CI/containers/servers); the Settings
#               page then cannot save/remove keys.
AI_CREDENTIAL_SOURCE=auto

# The model identifier to request, exactly as your provider expects it, e.g.
#   gpt-5            (OpenAI)
#   gpt-4.1
#   my-local-model   (local OpenAI-compatible servers / company gateways)
AI_MODEL=gpt-5
AI_TIMEOUT_SECONDS=120

# Desktop users can also configure everything from the Settings page (Base URL, Model,
# API key) without any environment variables. On Windows the key is stored per-user in
# the Windows Credential Manager (target "EmailAI/AI") - never in files next to the
# app, never in appsettings.json, never in the installer. Server/container deployments
# keep using AI_API_KEY above (set AI_CREDENTIAL_SOURCE=environment).

# ---------------------------------------------------------------------
# Opt-in REAL integration tests (never required by the normal unit suite)
# ---------------------------------------------------------------------
# The normal unit suite runs fully offline. These tests only execute when
# explicitly enabled below and make REAL network calls to the configured AI
# provider / Exchange server. Never commit real credentials; when the variables
# are missing the tests report "not configured" and complete without calling any service.
#
#   AI provider integration test (any OpenAI-compatible endpoint):
#     EMAILAI_AI_INTEGRATION_TEST=true
#     EMAILAI_AI_BASE_URL=https://your-company-ai.example.com/v1
#     EMAILAI_AI_API_KEY=
#     EMAILAI_AI_MODEL=
#
#   Exchange integration test (uses the EXCHANGE_* variables above):
#     EMAILAI_EXCHANGE_INTEGRATION_TEST=true

# ---------------------------------------------------------------------
# ASP.NET Core
# ---------------------------------------------------------------------
# The Blazor UI and the API are served from the same origin (see README).
ASPNETCORE_URLS=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development
